# Strava API Credentials
# Get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# PostgreSQL
POSTGRES_USER=strava
POSTGRES_PASSWORD=changeme_to_a_secure_password
POSTGRES_DB=strava_fitness

# App settings
# The URL where this service is reachable (used for OAuth callback)
APP_BASE_URL=http://localhost:8000

# Heart rate and power
# Precedence per value: MAX_HR/REST_HR/FTP env > DEFAULT_MAX_HR/DEFAULT_REST_HR env
# > Strava profile > built-in fallback (190 / 60 / 200). When MAX_HR/REST_HR
# resolves from the environment, any custom HR zones from Strava are ignored and
# percentage-based zones are computed from MAX_HR for consistency.
# docker-compose.yml sets DEFAULT_MAX_HR=190 and DEFAULT_REST_HR=60 by default,
# so the app uses those unless you set MAX_HR/REST_HR here or unset the defaults.
# See DEVELOPERS.md for the full table.
# MAX_HR=190
# REST_HR=60
# FTP=250

# Sync interval in minutes
SYNC_INTERVAL_MINUTES=15

# MCP service
# Exposed by docker compose as http://your-host:8001/mcp
MCP_PORT=8001
# Comma-separated Host headers accepted by the MCP server. Add your homeserver
# hostname or LAN IP when connecting from another machine, e.g.
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,homeserver.local:*,192.168.1.10:*
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
