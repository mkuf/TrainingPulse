# Docker Compose variables only. All application configuration now lives in
# config.yaml — copy config.example.yaml to get started.
#
# The db and grafana containers need these as environment variables, and
# Compose composes TP_DATABASE__URL for the app and mcp services from them.
POSTGRES_USER=trainingpulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trainingpulse

# Host port published for the MCP server. The container always listens on 8001.
MCP_PORT=8001

# Optional: names referenced by ${VAR} interpolation in config.example.yaml.
# Set them here to keep credentials out of config.yaml, or delete them and put
# the values directly in config.yaml instead.
INTERVALS_ICU_API_KEY=
STRAVA_CLIENT_SECRET=
GOOGLE_HEALTH_CLIENT_SECRET=
WITHINGS_CLIENT_SECRET=
FDDB_PW=
FDDB_COOKIE=
