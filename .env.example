# intervals.icu
# API key from https://intervals.icu/settings → Developer Settings
INTERVALS_ICU_API_KEY=your_api_key_here
# INTERVALS_ICU_API_BASE=https://intervals.icu/api/v1

# Google Health API (OAuth)
# Create an OAuth client in Google Cloud; enable Google Health API;
# set redirect URI to {APP_BASE_URL}/auth/google/callback
# For personal use: set OAuth consent screen to "In production" (can stay unverified)
# so refresh tokens are not limited to 7 days (Testing mode expires weekly).
# GOOGLE_HEALTH_CLIENT_ID=
# GOOGLE_HEALTH_CLIENT_SECRET=
# GOOGLE_HEALTH_API_BASE=https://health.googleapis.com/v4

# Comma-separated activity sources: icu, google_health
ENABLED_ACTIVITY_SOURCES=icu,google_health

# PostgreSQL (TrainingPulse core database)
POSTGRES_USER=trainingpulse
POSTGRES_PASSWORD=changeme_to_a_secure_password
POSTGRES_DB=trainingpulse

# App settings
APP_BASE_URL=http://localhost:8000

# Heart rate and power (see DEVELOPERS.md)
# MAX_HR=190
# REST_HR=60
# FTP=250

SYNC_INTERVAL_MINUTES=15
# Re-list activities this many days back each sync to pick up edits (0 = disable)
SYNC_RECONCILE_DAYS=90
# SYNC_BACKFILL_YEARS=10
# SYNC_ICU_WINDOW_DAYS=90

# MCP service — http://localhost:8001/mcp
MCP_PORT=8001
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# ── Optional plugins (in-process) ─────────────────────────────────────────────
# Comma-separated: withings, fddb
# Plugin tables use schemas `withings` and `fddb` in POSTGRES_DB (same as core).
# ENABLED_PLUGINS=withings,fddb

# Withings (body weight) — also set callback URL in Partner Hub to:
#   http://localhost:8000/plugins/withings/get_token
# WITHINGS_CLIENT_ID=
# WITHINGS_CLIENT_SECRET=
# WITHINGS_SYNC_INTERVAL_MINUTES=60

# FDDB (nutrition) — session cookie from browser devtools
# FDDB_USER=
# FDDB_PW=
# FDDB_COOKIE=
# FDDB_SYNC_INTERVAL_MINUTES=60
