# Strava API Credentials
# Get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# PostgreSQL (TrainingPulse core database)
POSTGRES_USER=trainingpulse
POSTGRES_PASSWORD=changeme_to_a_secure_password
POSTGRES_DB=trainingpulse

# App settings
APP_BASE_URL=http://localhost:8000

# Heart rate and power (see DEVELOPERS.md)
# MAX_HR=190
# REST_HR=60
# FTP=250

SYNC_INTERVAL_MINUTES=15
# Re-list activities this many days back each sync to pick up Strava edits (0 = disable)
SYNC_RECONCILE_DAYS=90

# MCP service — http://localhost:8001/mcp
MCP_PORT=8001
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# ── Optional plugins (in-process) ─────────────────────────────────────────────
# Comma-separated: withings, fddb
# Plugin tables use schemas `withings` and `fddb` in POSTGRES_DB (same as core).
# ENABLED_PLUGINS=withings,fddb

# Withings (body weight) — also set callback URL in Partner Hub to:
#   http://localhost:8000/plugins/withings/get_token
# WITHINGS_CLIENT_ID=
# WITHINGS_CLIENT_SECRET=
# WITHINGS_SYNC_INTERVAL_MINUTES=60

# FDDB (nutrition) — session cookie from browser devtools
# FDDB_USER=
# FDDB_PW=
# FDDB_COOKIE=
# FDDB_SYNC_INTERVAL_MINUTES=60
