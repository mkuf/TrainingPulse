# Build context is the repository root (see docker-compose.yml), so this file
# is what actually applies — app/.dockerignore is never read.
.git
.gitignore
.env
.env.*
config.yaml
.kilo
.cursor
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.ruff_cache
**/*.egg-info
**/.venv
# Database dumps (e.g. backup.sql) would otherwise be sent with every build.
*.sql
# Tests stay out of the image; the test service mounts the repository instead.
app/tests
app/integration_tests
app/pytest.ini
grafana/dashboards
README.md
docs
