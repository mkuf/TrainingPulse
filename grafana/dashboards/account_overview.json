    {
      "type": "table",
      "title": "Period comparison",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "description": "Totals for fixed periods up to now. They do not depend on the dashboard time range. **Calories** sum the calories TrainingPulse computed (from power, distance or heart rate) and, where an activity has none, the imported value.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Distance"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: km"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Moving time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: h"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Elevation"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: m"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Calories"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: kcal"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Period"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "WITH periods (ord, label, p_from, p_to) AS (\n  VALUES\n    (1, 'Last 28 days', NOW() - INTERVAL '28 days', NOW()),\n    (2, 'The 28 days before', NOW() - INTERVAL '56 days', NOW() - INTERVAL '28 days'),\n    (3, 'This month so far', date_trunc('month', NOW()), NOW()),\n    (4, 'Last month', date_trunc('month', NOW() - INTERVAL '1 month'), date_trunc('month', NOW())),\n    (5, 'Same month last year', date_trunc('month', NOW() - INTERVAL '1 year'), date_trunc('month', NOW() - INTERVAL '1 year') + INTERVAL '1 month'),\n    (6, 'This year so far', date_trunc('year', NOW()), NOW()),\n    (7, 'Last year, same days', date_trunc('year', NOW()) - INTERVAL '1 year', NOW() - INTERVAL '1 year')\n)\nSELECT\n  p.label AS \"Period\",\n  COUNT(a.id)::int AS \"Activities\",\n  SUM(a.distance) / 1000.0 AS \"Distance\",\n  SUM(a.moving_time) / 3600.0 AS \"Moving time\",\n  SUM(a.total_elevation_gain) AS \"Elevation\",\n  ROUND(SUM(a.trimp)::numeric, 0) AS \"TRIMP\",\n  ROUND(SUM(COALESCE(a.computed_calories, a.calories))::numeric, 0) AS \"Calories\"\nFROM periods p\nLEFT JOIN active_activities a ON a.start_date >= p.p_from AND a.start_date < p.p_to\nGROUP BY p.ord, p.label\nORDER BY p.ord",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
