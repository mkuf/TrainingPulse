          "format": "table",
          "refId": "A",
          "rawSql": "WITH raw AS (\n  SELECT\n    (t.point->>0)::double precision AS lat,\n    (t.point->>1)::double precision AS lng\n  FROM activity_streams s\n  INNER JOIN active_activities a ON a.id = s.activity_id\n  CROSS JOIN LATERAL jsonb_array_elements(s.data->'latlng') WITH ORDINALITY AS t(point, idx)\n  WHERE $__timeFilter(a.start_date)\n    AND s.data ? 'latlng'\n    AND t.idx % 20 = 1\n),\nb AS (\n  SELECT\n    percentile_cont(0.02) WITHIN GROUP (ORDER BY lat) AS lat_min,\n    percentile_cont(0.98) WITHIN GROUP (ORDER BY lat) AS lat_max,\n    percentile_cont(0.02) WITHIN GROUP (ORDER BY lng) AS lng_min,\n    percentile_cont(0.98) WITHIN GROUP (ORDER BY lng) AS lng_max\n  FROM raw\n)\nSELECT r.lat, r.lng\nFROM raw r\nCROSS JOIN b\nWHERE r.lat BETWEEN b.lat_min AND b.lat_max\n  AND r.lng BETWEEN b.lng_min AND b.lng_max\nLIMIT 50000"
        },
