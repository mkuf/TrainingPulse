      "title": "Monthly distance and activities",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT\n  GREATEST(date_trunc('month', start_date), $__timeFrom())::date AS time,\n  ROUND((SUM(distance) / 1000.0)::numeric, 1) AS \"Distance (km)\",\n  COUNT(*)::int AS \"Activities\"\nFROM active_activities\nWHERE $__timeFilter(start_date)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
