      "title": "Fitness, fatigue and form",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "SELECT\n  date AS time,\n  ctl AS \"Fitness (CTL)\",\n  atl AS \"Fatigue (ATL)\",\n  tsb AS \"Form (TSB)\",\n  daily_trimp AS \"Daily TRIMP\"\nFROM daily_metrics\nWHERE $__timeFilter(date)\nORDER BY date",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "description": "**Fitness (CTL)** is your average daily TRIMP of the last 42 days. **Fatigue (ATL)** is the same for the last 7 days. **Form (TSB)** is fitness minus fatigue. The bars show the daily TRIMP (right axis)."
