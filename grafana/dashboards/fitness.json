      "title": "Form (TSB %)",
      "description": "Freshness: fitness minus fatigue, in percent of fitness.\n- Above +25 %: Transition, you lose fitness\n- +5 to +25 %: Fresh\n- −10 to +5 %: Neutral\n- −30 to −10 %: Optimal training\n- Below −30 %: High risk",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "SELECT d.date AS time, 100.0 * d.tsb / p.ctl AS \"Form\"\nFROM daily_metrics d\nJOIN daily_metrics p ON p.athlete_id = d.athlete_id AND p.date = d.date - 1\nWHERE $__timeFilter(d.date) AND p.ctl > 0\nORDER BY d.date",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "SELECT\n  CASE\n    WHEN 100.0 * d.tsb / p.ctl < -30 THEN 'High risk'\n    WHEN 100.0 * d.tsb / p.ctl < -10 THEN 'Optimal training'\n    WHEN 100.0 * d.tsb / p.ctl < 5 THEN 'Neutral'\n    WHEN 100.0 * d.tsb / p.ctl < 25 THEN 'Fresh'\n    ELSE 'Transition'\n  END AS \"State\"\nFROM daily_metrics d\nJOIN daily_metrics p ON p.athlete_id = d.athlete_id AND p.date = d.date - 1\nWHERE $__timeFilter(d.date) AND p.ctl > 0\nORDER BY d.date DESC\nLIMIT 1",
          "format": "table",
          "refId": "B",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "B",
            "applyTo": {
              "id": "byName",
              "options": "Form"
            },
            "mappings": [
              {
                "fieldName": "State",
                "handlerKey": "displayName"
              }
            ]
          }
        }
      ]
    },
