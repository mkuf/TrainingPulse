        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "hidden" }
      },
      "title": "Daily Training Load (TRIMP)",
      "type": "barchart",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "SELECT\n  date AS time,\n  daily_trimp AS \"TRIMP\"\nFROM daily_metrics\nWHERE $__timeFilter(date)\n  AND daily_trimp > 0\nORDER BY date",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
