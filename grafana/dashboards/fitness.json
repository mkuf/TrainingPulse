          },
          "format": "table",
          "rawSql": "WITH cw AS (\n  SELECT date_trunc('week', CURRENT_DATE)::date AS ws\n),\nflags AS (\n  SELECT\n    cw.ws,\n    EXISTS (\n      SELECT 1 FROM activities a\n      WHERE date_trunc('week', a.start_date)::date = cw.ws\n    ) AS has_current\n  FROM cw cw\n),\nanchor AS (\n  SELECT\n    CASE WHEN has_current THEN ws ELSE ws - 7 END AS anchor_week,\n    has_current\n  FROM flags\n)\nSELECT\n  CASE\n    WHEN NOT EXISTS (\n      SELECT 1 FROM activities a, anchor an\n      WHERE date_trunc('week', a.start_date)::date = an.anchor_week\n    ) THEN 0\n    ELSE COALESCE(\n      (\n        SELECT MIN(n)\n        FROM generate_series(0, 500) AS n\n        CROSS JOIN anchor an\n        WHERE NOT EXISTS (\n          SELECT 1 FROM activities a\n          WHERE date_trunc('week', a.start_date)::date = an.anchor_week - (n::integer * 7)\n        )\n      ),\n      500\n    )\n  END AS \"Weekly streak\",\n  CASE WHEN (SELECT has_current FROM anchor) THEN '#FC4C02' ELSE '#B4B4B6' END AS \"Streak color\"",
