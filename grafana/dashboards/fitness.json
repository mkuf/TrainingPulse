          }
        }
      ],
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "WITH bounds AS (\n  SELECT MIN(date) AS history_start, date_trunc('week', MAX(date))::date AS monday\n  FROM daily_metrics\n),\nweek AS (\n  SELECT\n    CASE\n      WHEN b.monday - b.history_start >= 42 AND p.ctl > 0 THEN 7 * p.ctl\n    END AS target,\n    (SELECT COALESCE(SUM(daily_trimp), 0) FROM daily_metrics WHERE date >= b.monday) AS load\n  FROM bounds b\n  LEFT JOIN daily_metrics p ON p.date = b.monday - 1\n)\nSELECT\n  ROUND((target * 1.0)::numeric, 0) AS \"Target\",\n  ROUND((target * 1.3)::numeric, 0) AS \"Upper limit\",\n  ROUND(load::numeric, 0) AS \"This week\",\n  CASE\n    WHEN target IS NULL THEN '#B4B4B6'\n    WHEN load > target * 1.3 THEN '#FF9830'\n    WHEN load >= target * 1.0 THEN '#56A64B'\n    ELSE '#8e8e90'\n  END AS \"This week color\"\nFROM week",
          "format": "table",
          "refId": "A"
        }
      ]
    },
