    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "description": "Consecutive calendar weeks (Monday start, same as **This week vs corridor**) with at least one logged activity. Counting starts from the **last week that contains any activity** when **this week is still empty** — so you see how long your run was without forcing **0** before you train. **Highlight**: current week already has an activity (live streak). **Grey**: current week has no activity yet (same number = run ending at your last active week; logging this week applies the highlight).",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Weekly streak$/",
          "values": true
        },
        "textMode": "value"
      },
      "title": "Weekly streak",
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "A",
            "applyTo": {
              "id": "byName",
              "options": "Weekly streak"
            },
            "mappings": [
              {
                "fieldName": "Streak color",
                "handlerKey": "color"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Streak color": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "format": "table",
          "rawSql": "WITH cw AS (\n  SELECT date_trunc('week', CURRENT_DATE)::date AS ws\n),\nflags AS (\n  SELECT\n    cw.ws,\n    EXISTS (\n      SELECT 1 FROM active_activities a\n      WHERE date_trunc('week', a.start_date)::date = cw.ws\n    ) AS has_current\n  FROM cw cw\n),\nanchor AS (\n  SELECT\n    CASE WHEN has_current THEN ws ELSE ws - 7 END AS anchor_week,\n    has_current\n  FROM flags\n)\nSELECT\n  CASE\n    WHEN NOT EXISTS (\n      SELECT 1 FROM active_activities a, anchor an\n      WHERE date_trunc('week', a.start_date)::date = an.anchor_week\n    ) THEN 0\n    ELSE COALESCE(\n      (\n        SELECT MIN(n)\n        FROM generate_series(0, 500) AS n\n        CROSS JOIN anchor an\n        WHERE NOT EXISTS (\n          SELECT 1 FROM active_activities a\n          WHERE date_trunc('week', a.start_date)::date = an.anchor_week - (n::integer * 7)\n        )\n      ),\n      500\n    )\n  END AS \"Weekly streak\",\n  CASE WHEN (SELECT has_current FROM anchor) THEN '#FC4C02' ELSE '#B4B4B6' END AS \"Streak color\"",
          "refId": "A"
        }
      ]
    },
