      "title": "Weekly training load by sport",
      "description": "The grey band is the weekly load target. At the lower line, your fitness stays the same. In the band, your fitness increases. Above the band, the load increases faster than you can usually sustain. The target is 7 × your fitness at the start of the week. It shows after 6 weeks of training history.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "WITH bounds AS (\n  SELECT MIN(date) AS history_start, MAX(date) AS last_day\n  FROM daily_metrics\n),\nweeks AS (\n  SELECT\n    generate_series(date_trunc('week', history_start), date_trunc('week', last_day), '1 week'::interval)::date AS time,\n    history_start\n  FROM bounds\n)\nSELECT\n  w.time,\n  ROUND((7 * d.ctl * 1.0)::numeric, 0) AS \"Target\",\n  ROUND((7 * d.ctl * 1.3)::numeric, 0) AS \"Upper limit\"\nFROM weeks w\nJOIN daily_metrics d ON d.date = w.time - 1\nWHERE w.time - w.history_start >= 42 AND d.ctl > 0 AND $__timeFilter(w.time)\nORDER BY w.time",
          "format": "time_series",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "SELECT\n  date_trunc('week', start_date)::date AS time,\n  sport_type AS metric,\n  ROUND(SUM(COALESCE(trimp, 0))::numeric, 0) AS value\nFROM active_activities\nWHERE $__timeFilter(start_date)\nGROUP BY 1, 2\nORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
