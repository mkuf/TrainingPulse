            "matcher": { "id": "byName", "options": "Ceiling" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#B4B4B6" } },
              { "id": "displayName", "value": "Ceiling (125%)" }
            ]
