      "title": "Form (TSB)",
      "description": "Training Stress Balance (CTL - ATL). Represents freshness.\n- +5 to +25: Fresh (Peak)\n- -10 to +5: Neutral\n- -30 to -10: Productive Overload\n- Below -30: Danger Zone",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "SELECT date AS time, tsb AS \"Form\" FROM daily_metrics WHERE $__timeFilter(date) ORDER BY date",
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "SELECT\n  CASE\n    WHEN tsb < -25 THEN 'Overreaching'\n    WHEN tsb < -10 THEN 'Training Hard'\n    WHEN tsb < 5 THEN 'Neutral'\n    WHEN tsb < 15 THEN 'Rested'\n    ELSE 'Race Ready'\n  END AS \"State\"\nFROM daily_metrics\nWHERE $__timeFilter(date)\nORDER BY date DESC\nLIMIT 1",
          "format": "table",
          "refId": "B",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "B",
            "applyTo": {
              "id": "byName",
              "options": "Form"
            },
            "mappings": [
              {
                "fieldName": "State",
                "handlerKey": "displayName"
              }
            ]
          }
        }
      ]
