      "type": "trend",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "WITH points AS (\n  SELECT\n    pc.duration::int AS duration_sec,\n    pc.power::float AS watts,\n    $__timeFilter(a.start_date) AS in_range\n  FROM active_activities a,\n  LATERAL jsonb_each_text(a.power_curve) AS pc(duration, power)\n  WHERE jsonb_typeof(a.power_curve) = 'object'\n)\nSELECT\n  duration_sec,\n  MAX(watts) AS \"All time\",\n  MAX(watts) FILTER (WHERE in_range) AS \"Selected range\"\nFROM points\nGROUP BY duration_sec\nORDER BY duration_sec",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
