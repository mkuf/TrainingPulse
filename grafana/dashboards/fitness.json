      "title": "This week vs corridor",
      "description": "Numbers for the **calendar week containing today** (ISO week, Monday start). **Floor** and **Ceiling** use the same rule as the chart: 80% and 125% of the average total weekly TRIMP from the **four complete weeks before** this week. **This week** is your summed TRIMP so far in the current week. **Floor** / **Ceiling** tiles use **blue** / **purple** backgrounds. **This week** tile color is **grey** under the floor, **green** between floor and ceiling (inclusive), and a **warning highlight** above the ceiling (when the corridor is defined).",
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "A",
            "applyTo": {
              "id": "byName",
              "options": "Week total"
            },
            "mappings": [
              {
                "fieldName": "Week total color",
                "handlerKey": "color"
              }
            ]
          }
        }
      ],
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "WITH bounds AS (\n  SELECT\n    date_trunc('week', MIN(start_date)) AS min_date,\n    date_trunc('week', CURRENT_DATE) AS max_date\n  FROM active_activities\n),\ndate_series AS (\n  SELECT generate_series(min_date, max_date, '1 week'::interval)::date AS time\n  FROM bounds\n),\nweekly_load AS (\n  SELECT\n    ds.time,\n    COALESCE(SUM(a.trimp), 0) AS total_load\n  FROM date_series ds\n  LEFT JOIN active_activities a ON date_trunc('week', a.start_date)::date = ds.time\n  GROUP BY ds.time\n),\ncorridor AS (\n  SELECT\n    time,\n    total_load,\n    AVG(total_load) OVER (ORDER BY time ROWS BETWEEN 4 PRECEDING AND 1 PRECEDING) AS prior_four_avg\n  FROM weekly_load\n)\nSELECT\n  ROUND((prior_four_avg * 0.8)::numeric, 0) AS \"Floor\",\n  ROUND((prior_four_avg * 1.25)::numeric, 0) AS \"Ceiling\",\n  ROUND(total_load::numeric, 0) AS \"Week total\",\n  CASE\n    WHEN prior_four_avg IS NULL THEN '#B4B4B6'\n    WHEN total_load < prior_four_avg * 0.8 THEN '#8e8e90'\n    WHEN total_load <= prior_four_avg * 1.25 THEN '#56A64B'\n    ELSE '#FF9830'\n  END AS \"Week total color\"\nFROM corridor\nWHERE time = date_trunc('week', CURRENT_DATE)::date",
          "format": "table",
          "refId": "A"
        }
      ]
    },
