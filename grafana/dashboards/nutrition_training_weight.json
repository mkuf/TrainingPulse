        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "WITH days AS (\n  SELECT n.day, n.kcal - w.total_kcal AS balance\n  FROM active_daily_nutrition n\n  JOIN active_daily_wellness w ON w.day = n.day\n  WHERE n.day BETWEEN $__timeFrom()::date AND $__timeTo()::date\n    AND n.day < CURRENT_DATE\n),\nweights AS (\n  SELECT date_trunc('week', day)::date AS week, AVG(weight_kg) AS kg\n  FROM active_body_measurements\n  WHERE day BETWEEN $__timeFrom()::date - 7 AND $__timeTo()::date\n    AND weight_kg IS NOT NULL\n    AND '${show_weight}' = 'true'\n  GROUP BY 1\n),\nweeks AS (\n  SELECT date_trunc('week', day)::date AS week, AVG(balance) AS balance\n  FROM days\n  GROUP BY 1\n)\nSELECT\n  w.week::timestamp AS time,\n  w.balance AS \"Average daily balance\",\n  wt.kg - LAG(wt.kg) OVER (ORDER BY w.week) AS \"Weight change\"\nFROM weeks w\nLEFT JOIN weights wt ON wt.week = w.week\nORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
