    {
      "type": "stat",
      "title": "Intake",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "description": "Average daily intake in the time range.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: kcal",
          "decimals": 0,
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "/^Intake$/",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "WITH days AS (\n  SELECT generate_series($__timeFrom()::date, $__timeTo()::date, INTERVAL '1 day')::date AS day\n),\nactivity AS (\n  SELECT start_date::date AS day, SUM(COALESCE(computed_calories, calories)) AS kcal\n  FROM active_activities\n  WHERE $__timeFilter(start_date)\n  GROUP BY 1\n)\nSELECT\n  d.day::timestamp AS time,\n  n.kcal AS \"Intake\",\n  w.total_kcal AS \"Total burned\",\n  a.kcal AS \"Activities\",\n  CASE WHEN d.day < CURRENT_DATE THEN n.kcal - w.total_kcal END AS \"Balance\"\nFROM days d\nLEFT JOIN active_daily_nutrition n ON n.day = d.day\nLEFT JOIN active_daily_wellness w ON w.day = d.day\nLEFT JOIN activity a ON a.day = d.day\nORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
