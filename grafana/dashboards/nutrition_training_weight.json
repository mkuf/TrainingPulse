            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "WITH daily AS (\n  SELECT day, AVG(weight_kg) AS kg, AVG(fat_pct) AS fat\n  FROM active_body_measurements\n  WHERE day BETWEEN $__timeFrom()::date - 6 AND $__timeTo()::date\n    AND weight_kg IS NOT NULL\n    AND '${show_weight}' = 'true'\n  GROUP BY day\n)\nSELECT\n  day::timestamp AS time,\n  kg AS \"Weight\",\n  AVG(kg) OVER (ORDER BY day RANGE BETWEEN INTERVAL '6 days' PRECEDING AND CURRENT ROW) AS \"7-day average\",\n  fat AS \"Body fat\"\nFROM daily\nORDER BY 1",
