    {
      "type": "timeseries",
      "title": "Weekly energy balance and weight change",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "description": "Bars: the average daily intake minus total burned of each week (orange is a surplus, blue a deficit). Line: the change of the weekly average weight against the week before (right axis). About 7700 kcal of balance correspond to one kilogram of body weight. The weight line is hidden until you switch on **Show weight**.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: kcal",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "spanNulls": true,
            "axisSoftMin": 0,
            "axisSoftMax": 0,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
