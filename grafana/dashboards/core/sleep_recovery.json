        "enable": true,
        "iconColor": "rgba(87, 148, 242, 0.25)",
        "name": "Sleep",
        "rawQuery": "SELECT start_at AS time, end_at AS timeend,\n  'Sleep: ' || ROUND(COALESCE(asleep_seconds, 0) / 3600.0, 1) || ' h' || COALESCE(', score ' || ROUND(score::numeric), '') AS text\nFROM active_sleep_sessions\nWHERE start_at < $__timeTo() AND end_at > $__timeFrom()\nORDER BY start_at",
        "target": {
          "refId": "Anno"
        }
      }
    ]
