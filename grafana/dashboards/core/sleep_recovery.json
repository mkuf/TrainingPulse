          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT time, \"Stage\" FROM (\n  SELECT (e->>'start')::timestamptz AS time, e->>'stage' AS \"Stage\"\n  FROM active_sleep_sessions s, jsonb_array_elements(s.stages) e\n  WHERE s.end_at > $__timeFrom() AND s.start_at < $__timeTo()\n  UNION ALL\n  SELECT end_at, NULL FROM active_sleep_sessions\n  WHERE stages IS NOT NULL AND end_at > $__timeFrom() AND start_at < $__timeTo()\n) t ORDER BY 1"
        }
      ],
      "title": "Sleep stages",
      "type": "state-timeline"
