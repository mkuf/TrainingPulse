        "enable": true,
        "iconColor": "rgba(87, 148, 242, 0.25)",
        "name": "Sleep",
        "rawQuery": "SELECT s.start_at AS time, s.end_at AS timeend,\n  'Sleep: ' || ROUND(COALESCE(s.asleep_seconds, 0) / 3600.0, 1) || ' h' || COALESCE(', score ' || ROUND(d.sleep_score::numeric), '') AS text\nFROM active_sleep_sessions s LEFT JOIN daily_scores d ON d.day = s.day\nWHERE s.start_at < $__timeTo() AND s.end_at > $__timeFrom()\nORDER BY s.start_at",
        "target": {
          "refId": "Anno"
        }
      }
    ]
  },
