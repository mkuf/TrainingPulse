      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT d.day::timestamp AS time,\n  d.resting_hr AS \"Resting HR\",\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY w.resting_hr) AS \"7-day median (used for calories)\",\n  max(s.sleep_avg_hr) AS \"Sleeping HR (avg)\"\nFROM active_daily_wellness d\nLEFT JOIN daily_scores s ON s.day = d.day\nCROSS JOIN LATERAL (\n  SELECT resting_hr FROM active_daily_wellness w\n  WHERE w.day > d.day - 7 AND w.day <= d.day AND w.resting_hr IS NOT NULL\n) w\nWHERE d.day >= $__timeFrom()::date AND d.day <= $__timeTo()::date\nGROUP BY d.day, d.resting_hr ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Resting and sleeping heart rate",
      "type": "timeseries"
    },
