    {
      "id": 15,
      "title": "Route",
      "type": "geomap",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "basemap": {
          "config": {},
          "name": "Basemap",
          "type": "osm-standard"
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showMeasure": false,
          "showScale": true,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "style": {
                "color": {
                  "fixed": "#FC4C02"
                },
                "lineWidth": 3,
                "opacity": 0.9,
                "size": {
                  "fixed": 5,
                  "max": 10,
                  "min": 2
                }
              }
            },
            "location": {
              "latitude": "lat",
              "longitude": "lng",
              "mode": "coords"
            },
            "name": "Route",
            "type": "route"
          }
        ],
        "tooltip": {
          "mode": "details"
        },
        "view": {
          "allLayers": true,
          "dashboardVariable": false,
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "noRepeat": false,
          "zoom": 12
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "SELECT\n  (point->>0)::float AS lat,\n  (point->>1)::float AS lng\nFROM activity_streams,\nLATERAL jsonb_array_elements(data->'latlng') AS point\nWHERE activity_id = '${activity_id}'\n  AND data ? 'latlng'",
          "format": "table",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 13
      }
