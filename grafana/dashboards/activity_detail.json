    {
      "id": 6,
      "title": "Energy",
      "description": "Calories and mechanical work that TrainingPulse calculated: from measured power, else from pace (walks and runs), else from heart rate. A **\\*** marks a value imported from the provider, shown only when TrainingPulse could not calculate one.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "SELECT\n  CASE\n    WHEN computed_calories IS NOT NULL THEN ROUND(computed_calories::numeric, 0) || ' kcal'\n    WHEN calories IS NOT NULL THEN ROUND(calories::numeric, 0) || ' kcal*'\n  END AS \"Calories\",\n  CASE\n    WHEN computed_kilojoules IS NOT NULL THEN ROUND(computed_kilojoules::numeric, 0) || ' kJ'\n    WHEN kilojoules IS NOT NULL THEN ROUND(kilojoules::numeric, 0) || ' kJ*'\n  END AS \"Work\"\nFROM activities\nWHERE id = '${activity_id}'",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      }
    },
