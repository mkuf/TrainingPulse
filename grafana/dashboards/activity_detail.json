            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Elapsed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dthms"
              },
              {
                "id": "displayName",
                "value": "Elapsed time"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "Elapsed",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "rawSql": "SELECT\n  x.t::float AS \"Elapsed\",\n  ROUND((x.v::float)::numeric, 1) AS \"Altitude\"\nFROM activity_streams s,\nLATERAL ROWS FROM (\n  jsonb_array_elements_text(s.data->'time'),\n  jsonb_array_elements_text(s.data->'altitude')\n) WITH ORDINALITY AS x(t, v, idx)\nWHERE s.activity_id = '${activity_id}'\n  AND s.data ? 'altitude'\n  AND x.t IS NOT NULL\nORDER BY x.idx",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 27
