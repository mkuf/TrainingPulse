      "title": "Route",
      "type": "geomap",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRESQL}" },
          "rawSql": "SELECT\n  (point->>0)::float AS lat,\n  (point->>1)::float AS lng\nFROM activity_streams,\nLATERAL jsonb_array_elements(data->'latlng') AS point\nWHERE activity_id = ${activity_id}\n  AND data ? 'latlng'",
          "format": "table",
          "refId": "A"
        }
